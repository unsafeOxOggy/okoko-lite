# okoko-lite - dunst
[global]
    follow = mouse
    origin = top-right
    offset = (12, 44)
    width = (240, 380)
    notification_limit = 5
    corner_radius = 8
    frame_width = 2
    frame_color = "#82C8FF"
    separator_color = frame
    padding = 10
    horizontal_padding = 12
    gap_size = 6
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    icon_theme = Papirus-Dark
    max_icon_size = 40

[urgency_low]
    background = "#1C1D2B"
    foreground = "#888888"
    timeout = 4
[urgency_normal]
    background = "#1C1D2B"
    foreground = "#E6FFF5"
    timeout = 6
[urgency_critical]
    background = "#1C1D2B"
    foreground = "#E6FFF5"
    frame_color = "#D54E53"
    timeout = 0
